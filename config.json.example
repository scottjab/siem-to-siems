{
  "tsnet": {
    "hostname": "siem-to-siems",
    "auth_key": ""
  },
  "server": {
    "addr": ":8080"
  },
  "destinations": {
    "ndjson": {
      "directory": "./logs",
      "rotate": "1h"
    },
    "parquet": {
      "directory": "./parquet",
      "rotate": "5m",
      "journal": "5m",
      "daily_merge": "24h",
      "ndjson_files": false
    },
    "http": [
      {
        "url": "https://example.com/ingest",
        "token": "",
        "journal_directory": "",
        "initial_backoff": "1s",
        "max_backoff": "1m"
      }
    ]
  }
}


